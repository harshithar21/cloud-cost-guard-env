# CloudCostGuardEnv Environment Variables
# Copy to .env and fill in your actual values

# Server Configuration
TASK_ID=task_easy
SEED=42
ENV_BASE_URL=http://localhost:8000

# LLM / Inference Configuration
# Choose ONE of the following API providers:

# Option 1: HuggingFace Inference API
HF_TOKEN=hf_your_token_here
API_BASE_URL=https://api-inference.huggingface.co/v1
MODEL_NAME=meta-llama/Llama-3.2-3B-Instruct

# Option 2: OpenAI API
# OPENAI_API_KEY=sk-your_key_here
# API_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini

# Option 3: Other OpenAI-compatible API (e.g., Azure, local)
# API_BASE_URL=https://your-azure-endpoint.openai.azure.com/v1
# API_KEY=your-api-key
# MODEL_NAME=your-deployment-name
